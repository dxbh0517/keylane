/* Keylane Spotlight — a HUD, not a dialog.
 *
 * This is a TEMPLATE, not a stylesheet: ui/themes.py fills the double-brace
 * holes from the active theme and hands the result to GTK. Never edit rendered
 * CSS — change a token in ui/themes/<theme>.toml, or the structure here.
 *
 *   a hole with a light. or dark. prefix comes from the theme's [light] and
 *   [dark] tables; one without a prefix (radii, fonts) from its [common] table.
 *
 * Both schemes are rendered into one stylesheet, so switching light/dark is a
 * class swap (.style-light / .style-dark) with no reload. That is why every
 * themed rule is scheme-scoped, including the answer HUD's.
 *
 * Two surfaces:
 *   .spotlight-panel  centred command bar
 *   .corner-panel     top-right answer HUD, floating over arbitrary content
 *
 * The orb in ui/thinking_orb.py paints itself from the orb-* tokens.
 */

/* ── motion ─────────────────────────────────────────────────────────── */

@keyframes spotlight-in {
  from {
    opacity: 0;
    transform: translateY(-10px) scale(0.98);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes corner-in {
  from {
    opacity: 0;
    transform: translateY(-14px) scale(0.94);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes orb-in {
  from {
    opacity: 0;
    transform: scale(0.6);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

@keyframes accent-sweep {
  from {
    opacity: 0.35;
  }
  to {
    opacity: 0.9;
  }
}


/* ── typography ─────────────────────────────────────────────────────── */

window.spotlight-window,
window.settings-window,
popover.settings-dropdown-menu {
  font-family: {{font-ui}};
}

.spotlight-search,
.corner-title,
.settings-title,
.settings-section-title {
  font-family: {{font-display}};
}

.canvas-headline,
.canvas-text,
.canvas-quote,
.canvas-kv-value,
.corner-followup {
  font-family: {{font-answer}};
}

.spotlight-status,
.spotlight-pill,
.corner-status,
.canvas-heading,
.canvas-kv-key,
.settings-badge {
  font-family: {{font-label}};
}

/* ── shell ──────────────────────────────────────────────────────────── */

window.spotlight-window {
  background: transparent;
}

.spotlight-scrim {
  background: transparent;
  transition: background 200ms cubic-bezier(0.16, 1, 0.3, 1);
}

window.spotlight-window.style-light .spotlight-scrim.visible {
  background: {{light.scrim}};
}
window.spotlight-window.style-dark .spotlight-scrim.visible {
  background: {{dark.scrim}};
}


.spotlight-backdrop {
  background: transparent;
  transition:
    margin 300ms cubic-bezier(0.16, 1, 0.3, 1),
    opacity 220ms ease;
}

/* No scrim while the orb or the HUD is up — the desktop behind stays fully
   visible, and the input region in ui/main.py keeps it clickable too. */
window.spotlight-window.thinking-mode .spotlight-scrim,
window.spotlight-window.corner-mode .spotlight-scrim,
window.spotlight-window.thinking-mode .spotlight-backdrop,
window.spotlight-window.corner-mode .spotlight-backdrop {
  background: transparent;
}

/* ── thinking orb ───────────────────────────────────────────────────── */

.thinking-orb-wrap {
  background: transparent;
  padding: 0;
}

.thinking-orb {
  background: transparent;
}

window.spotlight-window.thinking-mode .thinking-orb {
  animation: orb-in 300ms cubic-bezier(0.34, 1.4, 0.5, 1);
}

/* ── command bar ────────────────────────────────────────────────────── */

.spotlight-panel {
  min-width: 600px;
  border-radius: {{radius-panel}};
  padding: 0;
  animation: spotlight-in 240ms cubic-bezier(0.16, 1, 0.3, 1);
}

window.spotlight-window.style-light .spotlight-panel {
  background-color: {{light.panel-bg}};
  border: 1px solid {{light.panel-border}};
  box-shadow: {{light.panel-shadow}};
}

window.spotlight-window.style-dark .spotlight-panel {
  background-color: {{dark.panel-bg}};
  border: 1px solid {{dark.panel-border}};
  box-shadow: {{dark.panel-shadow}};
}

.spotlight-search-row {
  padding: 16px 18px 16px 22px;
}

.spotlight-search {
  background: transparent;
  border: none;
  box-shadow: none;
  padding: 4px 0;
  font-size: 23px;
  font-weight: 400;
  letter-spacing: -0.022em;
}

entry.spotlight-search,
entry.spotlight-search:focus,
entry.spotlight-search:focus-within {
  outline: none;
  outline-width: 0;
  outline-offset: 0;
  box-shadow: none;
  border: none;
}

window.spotlight-window.style-light .spotlight-search {
  color: {{light.search-text}};
}

window.spotlight-window.style-dark .spotlight-search {
  color: {{dark.search-text}};
}

window.spotlight-window.style-light entry.spotlight-search:focus-within {
  caret-color: {{light.search-caret}};
}

window.spotlight-window.style-dark entry.spotlight-search:focus-within {
  caret-color: {{dark.search-caret}};
}

window.spotlight-window.style-light .spotlight-search-row {
  border-bottom: 1px solid {{light.row-divider}};
}

window.spotlight-window.style-dark .spotlight-search-row {
  border-bottom: 1px solid {{dark.row-divider}};
}

.spotlight-search-icon {
  min-width: 20px;
  min-height: 20px;
}

window.spotlight-window.style-light .spotlight-search-icon {
  color: {{light.search-icon}};
  opacity: 0.8;
}

window.spotlight-window.style-dark .spotlight-search-icon {
  color: {{dark.search-icon}};
  opacity: 0.85;
}

/* ── footer ─────────────────────────────────────────────────────────── */

.spotlight-footer {
  padding: 10px 18px 13px 22px;
}

window.spotlight-window.style-light .spotlight-footer {
  border-top: 1px solid {{light.row-divider}};
}

window.spotlight-window.style-dark .spotlight-footer {
  border-top: 1px solid {{dark.row-divider}};
}

.spotlight-status {
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}

window.spotlight-window.style-light .spotlight-status {
  color: {{light.status-text}};
}

window.spotlight-window.style-dark .spotlight-status {
  color: {{dark.status-text}};
}

.spotlight-pill {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  border-radius: {{radius-pill}};
  padding: 4px 11px;
}

window.spotlight-window.style-light .spotlight-pill {
  color: {{light.pill-text}};
  background: {{light.pill-bg}};
}

window.spotlight-window.style-dark .spotlight-pill {
  color: {{dark.pill-text}};
  background: {{dark.pill-bg}};
}

/* ── answer HUD ─────────────────────────────────────────────────────── */

.corner-panel {
  min-width: 340px;
  border-radius: {{radius-hud}};
  padding: 0;
  opacity: 1;
}

.corner-panel.corner-enter {
  animation: corner-in 320ms cubic-bezier(0.16, 1, 0.3, 1);
}

/* The HUD keeps one dark glass treatment in both schemes: it sits over
   whatever is on screen, so a light card would be unreadable half the time. */
window.spotlight-window.style-light .corner-panel,
window.spotlight-window.style-light.corner-dark .corner-panel {
  background-color: {{light.hud-bg}};
  border: 1px solid {{light.hud-border}};
  box-shadow: {{light.hud-shadow}};
}
window.spotlight-window.style-dark .corner-panel,
window.spotlight-window.style-dark.corner-dark .corner-panel {
  background-color: {{dark.hud-bg}};
  border: 1px solid {{dark.hud-border}};
  box-shadow: {{dark.hud-shadow}};
}


.corner-header {
  padding: 13px 12px 11px 15px;
}

.corner-orb {
  min-width: 22px;
  min-height: 22px;
  margin-top: 1px;
}

.corner-title {
  font-size: 13.5px;
  font-weight: 600;
  letter-spacing: -0.012em;
}

window.spotlight-window.style-light .corner-title {
  color: {{light.hud-title}};
}
window.spotlight-window.style-dark .corner-title {
  color: {{dark.hud-title}};
}


.corner-status {
  font-size: 11.5px;
  font-weight: 500;
  letter-spacing: 0.005em;
  animation: accent-sweep 900ms ease-in-out infinite alternate;
}

window.spotlight-window.style-light .corner-status {
  color: {{light.hud-status}};
}
window.spotlight-window.style-dark .corner-status {
  color: {{dark.hud-status}};
}


/* Once the answer has landed the status line states a fact, not activity.
   ui/main.py adds .settled to the panel when the reply arrives. */
.corner-panel.settled .corner-status {
  animation: none;
}

window.spotlight-window.style-light .corner-panel.settled .corner-status {
  color: {{light.hud-status-settled}};
}
window.spotlight-window.style-dark .corner-panel.settled .corner-status {
  color: {{dark.hud-status-settled}};
}


.corner-close {
  min-width: 26px;
  min-height: 26px;
  padding: 0;
  border-radius: {{radius-control}};
  background: transparent;
  border: none;
  opacity: 0.6;
  transition:
    opacity 140ms ease,
    background 140ms ease;
}

window.spotlight-window.style-light .corner-close {
  color: {{light.hud-close}};
}
window.spotlight-window.style-dark .corner-close {
  color: {{dark.hud-close}};
}


.corner-close:hover {
  opacity: 1;
}

window.spotlight-window.style-light .corner-close:hover {
  background: {{light.hud-close-hover-bg}};
}
window.spotlight-window.style-dark .corner-close:hover {
  background: {{dark.hud-close-hover-bg}};
}


.corner-answer-box {
  padding: 0 15px 12px;
}

.scrolledwindow.corner-scroll {
  border: none;
  background: transparent;
}

.scrolledwindow.corner-scroll scrollbar {
  opacity: 0.3;
  background: transparent;
  border: none;
}

.scrolledwindow.corner-scroll scrollbar slider {
  min-width: 5px;
  border-radius: 999px;
}

window.spotlight-window.style-light .scrolledwindow.corner-scroll scrollbar slider {
  background: {{light.hud-scrollbar}};
}
window.spotlight-window.style-dark .scrolledwindow.corner-scroll scrollbar slider {
  background: {{dark.hud-scrollbar}};
}


.corner-canvas-card {
  padding: 14px 15px;
  border-radius: {{radius-card}};
}

window.spotlight-window.style-light .corner-canvas-card {
  background-color: {{light.hud-card-bg}};
  border: 1px solid {{light.hud-card-border}};
}
window.spotlight-window.style-dark .corner-canvas-card {
  background-color: {{dark.hud-card-bg}};
  border: 1px solid {{dark.hud-card-border}};
}


/* ── canvas blocks ──────────────────────────────────────────────────── */

.canvas-headline {
  font-size: 15px;
  font-weight: 600;
  line-height: 1.45;
  letter-spacing: -0.014em;
}

window.spotlight-window.style-light .canvas-headline {
  color: {{light.hud-headline}};
}
window.spotlight-window.style-dark .canvas-headline {
  color: {{dark.hud-headline}};
}


.canvas-heading {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.09em;
  text-transform: uppercase;
  margin-top: 4px;
}

window.spotlight-window.style-light .canvas-heading {
  color: {{light.hud-heading}};
}
window.spotlight-window.style-dark .canvas-heading {
  color: {{dark.hud-heading}};
}


.canvas-text {
  font-size: 13.5px;
  line-height: 1.58;
  letter-spacing: -0.006em;
}

window.spotlight-window.style-light .canvas-text {
  color: {{light.hud-text}};
}
window.spotlight-window.style-dark .canvas-text {
  color: {{dark.hud-text}};
}


.canvas-quote {
  font-size: 13px;
  line-height: 1.55;
  font-style: italic;
  padding-left: 10px;
}

window.spotlight-window.style-light .canvas-quote {
  color: {{light.hud-quote-text}};
  border-left: 2px solid {{light.hud-quote-border}};
}
window.spotlight-window.style-dark .canvas-quote {
  color: {{dark.hud-quote-text}};
  border-left: 2px solid {{dark.hud-quote-border}};
}


.canvas-marker {
  font-size: 13px;
  font-weight: 600;
  min-width: 14px;
}

window.spotlight-window.style-light .canvas-marker {
  color: {{light.hud-marker}};
}
window.spotlight-window.style-dark .canvas-marker {
  color: {{dark.hud-marker}};
}


.canvas-kv-row {
  padding: 7px 10px;
  border-radius: {{radius-hud-control}};
}

window.spotlight-window.style-light .canvas-kv-row {
  background: {{light.hud-kv-bg}};
  border: 1px solid {{light.hud-kv-border}};
}
window.spotlight-window.style-dark .canvas-kv-row {
  background: {{dark.hud-kv-bg}};
  border: 1px solid {{dark.hud-kv-border}};
}


.canvas-kv-key {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.05em;
  text-transform: uppercase;
}

window.spotlight-window.style-light .canvas-kv-key {
  color: {{light.hud-kv-key}};
}
window.spotlight-window.style-dark .canvas-kv-key {
  color: {{dark.hud-kv-key}};
}


.canvas-kv-value {
  font-size: 13.5px;
  line-height: 1.5;
}

window.spotlight-window.style-light .canvas-kv-value {
  color: {{light.hud-kv-value}};
}
window.spotlight-window.style-dark .canvas-kv-value {
  color: {{dark.hud-kv-value}};
}


.canvas-code-scroll {
  border-radius: {{radius-hud-control}};
}

window.spotlight-window.style-light .canvas-code-scroll {
  background: {{light.hud-code-bg}};
  border: 1px solid {{light.hud-code-border}};
}
window.spotlight-window.style-dark .canvas-code-scroll {
  background: {{dark.hud-code-bg}};
  border: 1px solid {{dark.hud-code-border}};
}


.canvas-code-scroll scrollbar {
  opacity: 0.25;
}

.canvas-code {
  font-family: {{font-mono}};
  font-size: 12px;
  line-height: 1.5;
  padding: 10px 12px;
}

window.spotlight-window.style-light .canvas-code {
  color: {{light.hud-code-text}};
}
window.spotlight-window.style-dark .canvas-code {
  color: {{dark.hud-code-text}};
}


.canvas-rule {
  min-height: 1px;
  margin: 3px 0;
}

window.spotlight-window.style-light .canvas-rule {
  background: {{light.hud-rule}};
}
window.spotlight-window.style-dark .canvas-rule {
  background: {{dark.hud-rule}};
}


window.spotlight-window.style-light .corner-canvas-card label:selected {
  background: {{light.hud-selection-bg}};
  color: {{light.hud-selection-text}};
}
window.spotlight-window.style-dark .corner-canvas-card label:selected {
  background: {{dark.hud-selection-bg}};
  color: {{dark.hud-selection-text}};
}


.corner-details-btn {
  padding: 6px 13px;
  border-radius: {{radius-hud-control}};
  font-size: 12px;
  font-weight: 500;
  transition:
    background 140ms ease,
    border-color 140ms ease;
}

window.spotlight-window.style-light .corner-details-btn {
  border: 1px solid {{light.hud-btn-border}};
  color: {{light.hud-btn-text}};
  background: {{light.hud-btn-bg}};
}
window.spotlight-window.style-dark .corner-details-btn {
  border: 1px solid {{dark.hud-btn-border}};
  color: {{dark.hud-btn-text}};
  background: {{dark.hud-btn-bg}};
}


window.spotlight-window.style-light .corner-details-btn:hover {
  background: {{light.hud-btn-hover-bg}};
  border-color: {{light.hud-btn-hover-border}};
  color: {{light.hud-btn-hover-text}};
}
window.spotlight-window.style-dark .corner-details-btn:hover {
  background: {{dark.hud-btn-hover-bg}};
  border-color: {{dark.hud-btn-hover-border}};
  color: {{dark.hud-btn-hover-text}};
}


/* ── follow-up field ────────────────────────────────────────────────── */

.corner-followup-row {
  padding: 9px 10px 11px 15px;
}

window.spotlight-window.style-light .corner-followup-row {
  border-top: 1px solid {{light.hud-followup-divider}};
}
window.spotlight-window.style-dark .corner-followup-row {
  border-top: 1px solid {{dark.hud-followup-divider}};
}


.corner-followup {
  background: transparent;
  border: none;
  box-shadow: none;
  padding: 3px 0;
  font-size: 13.5px;
  letter-spacing: -0.008em;
}

window.spotlight-window.style-light .corner-followup {
  color: {{light.hud-followup-text}};
  caret-color: {{light.hud-caret}};
}
window.spotlight-window.style-dark .corner-followup {
  color: {{dark.hud-followup-text}};
  caret-color: {{dark.hud-caret}};
}


entry.corner-followup,
entry.corner-followup:focus,
entry.corner-followup:focus-within {
  outline: none;
  outline-width: 0;
  box-shadow: none;
  border: none;
}

.corner-send-btn {
  min-width: 28px;
  min-height: 28px;
  padding: 0;
  border-radius: {{radius-hud-control}};
  border: none;
  transition:
    background 140ms ease,
    transform 100ms cubic-bezier(0.23, 1, 0.32, 1);
}

window.spotlight-window.style-light .corner-send-btn {
  color: {{light.hud-send-text}};
  background: {{light.hud-send-bg}};
}
window.spotlight-window.style-dark .corner-send-btn {
  color: {{dark.hud-send-text}};
  background: {{dark.hud-send-bg}};
}


window.spotlight-window.style-light .corner-send-btn:hover {
  background: {{light.hud-send-hover-bg}};
}
window.spotlight-window.style-dark .corner-send-btn:hover {
  background: {{dark.hud-send-hover-bg}};
}


.corner-send-btn:active {
  transform: scale(0.92);
}

/* ── shared buttons ─────────────────────────────────────────────────── */

.spotlight-icon-btn {
  min-width: 34px;
  min-height: 34px;
  padding: 6px;
  border-radius: {{radius-icon-btn}};
  background: transparent;
  border: none;
  transition:
    background 140ms ease,
    color 140ms ease,
    transform 100ms cubic-bezier(0.23, 1, 0.32, 1);
}

.spotlight-icon-btn:active {
  transform: scale(0.93);
}

window.spotlight-window.style-light .spotlight-icon-btn {
  color: {{light.icon-btn}};
}

window.spotlight-window.style-light .spotlight-icon-btn:hover {
  background: {{light.icon-btn-hover-bg}};
  color: {{light.icon-btn-hover-text}};
}

window.spotlight-window.style-dark .spotlight-icon-btn {
  color: {{dark.icon-btn}};
}

window.spotlight-window.style-dark .spotlight-icon-btn:hover {
  background: {{dark.icon-btn-hover-bg}};
  color: {{dark.icon-btn-hover-text}};
}

/* Recording is a state worth seeing from across the room. */
window.spotlight-window.style-light .spotlight-mic-btn:checked,
window.spotlight-window.style-light .spotlight-mic-active {
  color: {{light.mic-active-text}};
  background: {{light.mic-active-bg}};
}
window.spotlight-window.style-dark .spotlight-mic-btn:checked,
window.spotlight-window.style-dark .spotlight-mic-active {
  color: {{dark.mic-active-text}};
  background: {{dark.mic-active-bg}};
}


window.spotlight-window.style-light .spotlight-mic-btn:checked:hover,
window.spotlight-window.style-light .spotlight-mic-active:hover {
  background: {{light.mic-active-hover-bg}};
}
window.spotlight-window.style-dark .spotlight-mic-btn:checked:hover,
window.spotlight-window.style-dark .spotlight-mic-active:hover {
  background: {{dark.mic-active-hover-bg}};
}


.spotlight-footer-btn,
.spotlight-settings-btn {
  min-width: 28px;
  min-height: 28px;
  padding: 4px;
  border-radius: {{radius-control}};
  background: transparent;
  border: none;
  transition:
    background 140ms ease,
    color 140ms ease;
}

window.spotlight-window.style-light .spotlight-footer-btn,
window.spotlight-window.style-light .spotlight-settings-btn {
  color: {{light.footer-btn}};
}

window.spotlight-window.style-light .spotlight-footer-btn:hover,
window.spotlight-window.style-light .spotlight-settings-btn:hover {
  background: {{light.icon-btn-hover-bg}};
  color: {{light.icon-btn-hover-text}};
}

window.spotlight-window.style-dark .spotlight-footer-btn,
window.spotlight-window.style-dark .spotlight-settings-btn {
  color: {{dark.footer-btn}};
}

window.spotlight-window.style-dark .spotlight-footer-btn:hover,
window.spotlight-window.style-dark .spotlight-settings-btn:hover {
  background: {{dark.icon-btn-hover-bg}};
  color: {{dark.icon-btn-hover-text}};
}

/* ── attached image ─────────────────────────────────────────────────── */

.spotlight-image-row {
  padding: 10px 18px 10px 22px;
}

.spotlight-image-preview {
  border-radius: {{radius-control}};
}

.spotlight-image-label {
  font-size: 12.5px;
  font-weight: 500;
}

window.spotlight-window.style-light .spotlight-image-row {
  border-top: 1px solid {{light.row-divider}};
}

window.spotlight-window.style-light .spotlight-image-label {
  color: {{light.image-label}};
}

window.spotlight-window.style-dark .spotlight-image-row {
  border-top: 1px solid {{dark.row-divider}};
}

window.spotlight-window.style-dark .spotlight-image-label {
  color: {{dark.image-label}};
}

/* ── history list ───────────────────────────────────────────────────── */

.spotlight-history {
  border-top-style: solid;
  border-top-width: 1px;
}

.spotlight-history-row {
  padding: 8px 12px;
}

.spotlight-history-label {
  font-size: 13px;
}

window.spotlight-window.style-dark .spotlight-history {
  background-color: {{dark.history-bg}};
  border-top-color: {{dark.row-divider}};
}

window.spotlight-window.style-dark scrolledwindow.spotlight-history-scroll,
window.spotlight-window.style-dark scrolledwindow.spotlight-history-scroll viewport,
window.spotlight-window.style-dark listbox.spotlight-history-list,
window.spotlight-window.style-dark listbox.spotlight-history-list row {
  background-color: transparent;
  color: {{dark.history-text}};
}

window.spotlight-window.style-dark listbox.spotlight-history-list row:hover {
  background-color: {{dark.history-hover-bg}};
}

window.spotlight-window.style-dark listbox.spotlight-history-list row:selected {
  background-color: {{dark.history-selected-bg}};
}

window.spotlight-window.style-dark .spotlight-history-label {
  color: {{dark.history-text}};
}

window.spotlight-window.style-light .spotlight-history {
  background-color: {{light.history-bg}};
  border-top-color: {{light.row-divider}};
}

window.spotlight-window.style-light scrolledwindow.spotlight-history-scroll,
window.spotlight-window.style-light scrolledwindow.spotlight-history-scroll viewport,
window.spotlight-window.style-light listbox.spotlight-history-list,
window.spotlight-window.style-light listbox.spotlight-history-list row {
  background-color: transparent;
  color: {{light.history-text}};
}

window.spotlight-window.style-light listbox.spotlight-history-list row:hover {
  background-color: {{light.history-hover-bg}};
}

window.spotlight-window.style-light listbox.spotlight-history-list row:selected {
  background-color: {{light.history-selected-bg}};
}

window.spotlight-window.style-light .spotlight-history-label {
  color: {{light.history-text}};
}

/* ── Settings window (matches spotlight / corner aesthetic) ── */

window.settings-window {
  border-radius: {{radius-window}};
}

window.settings-window.style-dark {
  background-color: {{dark.window-bg}};
}

window.settings-window.style-light {
  background-color: {{light.window-bg}};
}

.settings-shell {
  min-width: 640px;
}

.settings-header {
  padding: 16px 20px 14px;
}

window.settings-window.style-light .settings-header {
  border-bottom: 1px solid {{light.divider}};
}
window.settings-window.style-dark .settings-header {
  border-bottom: 1px solid {{dark.divider}};
}


.settings-close {
  min-width: 32px;
  min-height: 32px;
  padding: 0;
  border-radius: {{radius-control}};
  font-size: 20px;
  font-weight: 400;
  line-height: 1;
  border: none;
  background: transparent;
  opacity: 0.65;
  transition: opacity 140ms ease, transform 100ms ease, background 140ms ease;
}

.settings-close:hover {
  opacity: 1;
}

.settings-close:active {
  transform: scale(0.94);
}

window.settings-window.style-light .settings-close {
  color: {{light.close-text}};
}

window.settings-window.style-light .settings-close:hover {
  background: {{light.close-hover-bg}};
}

window.settings-window.style-dark .settings-close {
  color: {{dark.close-text}};
}

window.settings-window.style-dark .settings-close:hover {
  background: {{dark.close-hover-bg}};
}

window.settings-window.style-dark .settings-shell {
  box-shadow: {{dark.shell-shadow}};
}

window.settings-window.style-light .settings-shell {
  box-shadow: {{light.shell-shadow}};
}

.settings-progress {
  min-height: 6px;
  border-radius: 999px;
}

.settings-progress-inline {
  min-width: 100px;
}

.settings-model-actions {
  margin-top: 4px;
}

.settings-pct {
  font-size: 12px;
  font-weight: 600;
  letter-spacing: -0.01em;
  font-variant-numeric: tabular-nums;
  min-width: 36px;
}

window.settings-window.style-light .settings-pct {
  color: {{light.pct-text}};
}

window.settings-window.style-dark .settings-pct {
  color: {{dark.pct-text}};
}

window.settings-window.style-dark progressbar.settings-progress trough {
  background: {{dark.progress-trough}};
  border-radius: 999px;
  min-height: 6px;
}

window.settings-window.style-dark progressbar.settings-progress progress {
  background: {{dark.progress-fill}};
  border-radius: 999px;
  min-height: 6px;
}

window.settings-window.style-light progressbar.settings-progress trough {
  background: {{light.progress-trough}};
  border-radius: 999px;
  min-height: 6px;
}

window.settings-window.style-light progressbar.settings-progress progress {
  background: {{light.progress-fill}};
  border-radius: 999px;
  min-height: 6px;
}

window.settings-window.style-light .settings-header {
  border-bottom-color: {{light.divider}};
}

window.settings-window.style-dark .settings-header {
  border-bottom-color: {{dark.divider}};
}

.settings-title {
  font-size: 20px;
  font-weight: 600;
  letter-spacing: -0.02em;
}

window.settings-window.style-light .settings-title {
  color: {{light.title-text}};
}

window.settings-window.style-dark .settings-title {
  color: {{dark.title-text}};
}

.settings-body {
  min-height: 0;
}

window.settings-window.style-light .settings-body,
window.settings-window.style-light .settings-shell {
  background-color: {{light.window-bg}};
}

window.settings-window.style-dark .settings-body,
window.settings-window.style-dark .settings-shell {
  background-color: {{dark.window-bg}};
}

.settings-nav-scroll {
  min-width: 168px;
}

window.settings-window.style-light .settings-nav-scroll {

#!/usr/bin/env bash
# Say what you want written; Keylane reads the screen and types it.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
VENV="${KEYLANE_VENV:-$ROOT/.venv}"
PYTHON="$("${ROOT}/scripts/_ui_python.sh")"
UI="${ROOT}/ui/main.py"

export PYTHONPATH="${ROOT}${PYTHONPATH:+:$PYTHONPATH}"
if [[ "$PYTHON" == "python3" ]]; then
  export PYTHONPATH="${VENV}/lib64/python3.14/site-packages:${VENV}/lib/python3.14/site-packages${PYTHONPATH:+:$PYTHONPATH}"
fi
# Deliberately not defaulted here: daemon/paths.py derives it from the
# install layout, and $ROOT/data is wrong inside a release.
[[ -n "${KEYLANE_DATA:-}" ]] && export KEYLANE_DATA

exec "$PYTHON" "$UI" --compose

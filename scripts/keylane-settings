#!/usr/bin/env python3
"""Keylane settings CLI."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))

from daemon.config import all_settings, reset_settings, save_settings  # noqa: E402
from ui.themes import DEFAULT_THEME_ID, ThemeError, list_themes, load_theme  # noqa: E402


def cmd_list(_args: argparse.Namespace) -> None:
    print(json.dumps(all_settings(), indent=2, ensure_ascii=False))


def cmd_get(args: argparse.Namespace) -> None:
    data = all_settings()
    section = data.get(args.section, {})
    if args.key:
        print(section.get(args.key, ""))
    else:
        print(json.dumps(section, indent=2, ensure_ascii=False))


def cmd_set(args: argparse.Namespace) -> None:
    section, _, key = args.path.partition(".")
    if not key:
        print("usage: keylane-settings set section.key value", file=sys.stderr)
        sys.exit(1)
    value: object = args.value
    if value.lower() in {"true", "false"}:
        value = value.lower() == "true"
    elif value.isdigit():
        value = int(value)
    save_settings(section, {key: value})
    print(f"saved {section}.{key}={value}")


def cmd_reset(args: argparse.Namespace) -> None:
    reset_settings(args.section)
    print("reset ok")


def cmd_wizard_web(_args: argparse.Namespace) -> None:
    print("Web search wizard")
    backend = input("Search backend [searxng/ddgs] (searxng): ").strip() or "searxng"
    url = input("SearXNG URL (http://127.0.0.1:8080): ").strip() or "http://127.0.0.1:8080"
    fallback = input("Enable DDGS fallback? [Y/n]: ").strip().lower() not in {"n", "no"}
    save_settings(
        "research",
        {
            "search_backend": backend,
            "searxng_url": url,
            "keyless_fallback": fallback,
        },
    )
    print("Web settings saved.")


def cmd_theme_list(_args: argparse.Namespace) -> None:
    active = str(all_settings().get("ui", {}).get("theme_id", DEFAULT_THEME_ID))
    for theme in list_themes():
        mark = "*" if theme.id == active else " "
        print(f"{mark} {theme.id:18} {theme.source:9} {theme.description}")


def cmd_theme_use(args: argparse.Namespace) -> None:
    try:
        theme = load_theme(args.theme_id)
    except ThemeError as exc:
        print(exc, file=sys.stderr)
        sys.exit(1)
    save_settings("ui", {"theme_id": theme.id})
    print(f"theme set to {theme.name}. Reopen Keylane, or pick it in Settings, to see it.")


def cmd_theme_new(args: argparse.Namespace) -> None:
    """Scaffold a theme in data/themes/ that starts from an existing one."""
    from daemon.paths import THEMES_DIR

    try:
        base = load_theme(args.base)
    except ThemeError as exc:
        print(exc, file=sys.stderr)
        sys.exit(1)

    theme_id = args.theme_id.strip().lower().replace(" ", "-")
    path = THEMES_DIR / f"{theme_id}.toml"
    if path.exists() and not args.force:
        print(f"{path} already exists (pass --force to overwrite)", file=sys.stderr)
        sys.exit(1)

    lines = [
        f"# {theme_id} — a theme of your own.",
        "#",
        f"# It starts from {base.id}: every token below is that theme's value, so you",
        "# can delete any line you do not want to change. The token list is in",
        "# README.md → Themes.",
        "",
        "[theme]",
        f'id = "{theme_id}"',
        f'name = "{theme_id.replace("-", " ").title()}"',
        'description = ""',
        f'extends = "{base.id}"',
        "",
        "[common]",
    ]
    lines += [f'{k} = {_toml_value(v)}' for k, v in sorted(base.common.items())]
    for scheme, table in (("light", base.light), ("dark", base.dark)):
        lines += ["", f"[{scheme}]"]
        lines += [f'{k} = {_toml_value(v)}' for k, v in sorted(table.items())]

    THEMES_DIR.mkdir(parents=True, exist_ok=True)
    path.write_text("\n".join(lines) + "\n", encoding="utf-8")
    print(f"wrote {path}")
    print(f"edit it, then: keylane-settings theme use {theme_id}")


def _toml_value(value: str) -> str:
    return f"'{value}'" if '"' in value else f'"{value}"'


def main() -> None:
    parser = argparse.ArgumentParser(prog="keylane-settings")
    sub = parser.add_subparsers(dest="cmd", required=True)

    sub.add_parser("list").set_defaults(func=cmd_list)

    p_get = sub.add_parser("get")
    p_get.add_argument("section")
    p_get.add_argument("key", nargs="?")
    p_get.set_defaults(func=cmd_get)

    p_set = sub.add_parser("set")
    p_set.add_argument("path")
    p_set.add_argument("value")
    p_set.set_defaults(func=cmd_set)

    p_reset = sub.add_parser("reset")
    p_reset.add_argument("section", nargs="?")
    p_reset.set_defaults(func=cmd_reset)

    theme = sub.add_parser("theme")
    theme_sub = theme.add_subparsers(dest="theme_cmd", required=True)
    theme_sub.add_parser("list").set_defaults(func=cmd_theme_list)
    t_use = theme_sub.add_parser("use")
    t_use.add_argument("theme_id")
    t_use.set_defaults(func=cmd_theme_use)
    t_new = theme_sub.add_parser("new")
    t_new.add_argument("theme_id")
    t_new.add_argument("--from", dest="base", default=DEFAULT_THEME_ID)
    t_new.add_argument("--force", action="store_true")
    t_new.set_defaults(func=cmd_theme_new)

    wiz = sub.add_parser("wizard")
    wiz_sub = wiz.add_subparsers(dest="wizard_cmd", required=True)
    wiz_sub.add_parser("web").set_defaults(func=cmd_wizard_web)

    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()

#!/usr/bin/env bash
# Start Keylane daemon (NPU agent API).
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
VENV="${KEYLANE_VENV:-$ROOT/.venv}"
PYTHON="${VENV}/bin/python"

export PYTHONPATH="${ROOT}${PYTHONPATH:+:$PYTHONPATH}"
# Deliberately not defaulted here: daemon/paths.py derives it from the
# install layout, and $ROOT/data is wrong inside a release.
[[ -n "${KEYLANE_DATA:-}" ]] && export KEYLANE_DATA

if [[ ! -x "$PYTHON" ]]; then
  PYTHON=python3
fi

exec "$PYTHON" -m daemon.main

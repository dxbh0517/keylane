[Unit]
Description=Keylane Spotlight UI
After=graphical-session.target keylane-daemon.service
PartOf=graphical-session.target
Wants=keylane-daemon.service

[Service]
Type=simple
WorkingDirectory=%KEYLANE_ROOT%
Environment=PYTHONPATH=%KEYLANE_ROOT%
Environment=KEYLANE_DATA=%KEYLANE_ROOT%/data
ExecStart=%KEYLANE_ROOT%/scripts/keylane-ui
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target

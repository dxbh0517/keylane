}

window.settings-window.style-dark .settings-nav-row:selected {
  background: {{dark.nav-selected-bg}};
}

window.settings-window.style-light .settings-nav-row:selected .settings-nav-label {
  color: {{light.nav-selected-text}};
  font-weight: 600;
}

window.settings-window.style-dark .settings-nav-row:selected .settings-nav-label {
  color: {{dark.nav-selected-text}};
  font-weight: 600;
}

.settings-content-scroll {
  background-color: transparent;
}

window.settings-window.style-dark scrolledwindow.settings-content-scroll,

}

window.settings-window.style-dark scrolledwindow.settings-nav-scroll,
window.settings-window.style-dark scrolledwindow.settings-nav-scroll viewport,
window.settings-window.style-dark listbox.settings-nav {
  background-color: {{dark.nav-bg}};
  color: {{dark.nav-text}};
}

window.settings-window.style-dark .settings-nav-scroll {

}

.settings-nav {
  padding: 8px;
  background-color: transparent;
}

window.settings-window.style-dark listbox.settings-nav row {
  background-color: transparent;
  color: inherit;
}

window.settings-window.style-light listbox.settings-nav row {
  background-color: transparent;
}

.settings-nav-row {
  border-radius: {{radius-control}};
  padding: 2px 4px;

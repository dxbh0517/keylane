}

window.settings-window.style-dark .settings-field-label {
  color: {{dark.field-label}};
}

.settings-field-hint {
  font-size: 12px;
  line-height: 1.45;
}

window.settings-window.style-light .settings-field-hint {
  color: {{light.field-hint}};
}

window.settings-window.style-dark .settings-field-hint {
  color: {{dark.field-hint}};
}

.settings-download-file {
  font-size: 12px;
  font-family: {{font-mono}};
  line-height: 1.35;
  opacity: 0.9;
}

window.settings-window.style-light .settings-download-file {
  color: {{light.download-file}};
}

window.settings-window.style-dark .settings-download-file {
  color: {{dark.download-file}};
}

.settings-status-line {
  font-size: 13px;
  font-weight: 500;
  letter-spacing: -0.01em;
  padding: 8px 12px;
  border-radius: {{radius-control}};
}

window.settings-window.style-light .settings-status-line {
  color: {{light.status-line-text}};
  background: {{light.status-line-bg}};
}

window.settings-window.style-dark .settings-status-line {
  color: {{dark.status-line-text}};
  background: {{dark.status-line-bg}};
}

.settings-entry,
.settings-spin,
.settings-dropdown-trigger {
  min-height: 36px;
  border-radius: {{radius-control}};
  padding: 0 12px;
  font-size: 14px;
  letter-spacing: -0.01em;
}

window.settings-window.style-light .settings-entry,
window.settings-window.style-light .settings-spin,
window.settings-window.style-light button.settings-dropdown-trigger {
  background: {{light.control-bg}};
  color: {{light.control-text}};
  border: 1px solid {{light.control-border}};
  box-shadow: {{light.control-shadow}};
}

window.settings-window.style-dark .settings-entry,
window.settings-window.style-dark .settings-spin,
window.settings-window.style-dark button.settings-dropdown-trigger {
  background: {{dark.control-bg}};
  color: {{dark.control-text}};
  border: 1px solid {{dark.control-border}};
  box-shadow: {{dark.control-shadow}};
}

.settings-entry:focus-within,
.settings-spin:focus-within {
  outline: none;
}

window.settings-window.style-light .settings-entry:focus-within,
window.settings-window.style-light .settings-spin:focus-within {
  border-color: {{light.entry-focus-border}};
  box-shadow: {{light.entry-focus-ring}};
}

window.settings-window.style-dark .settings-entry:focus-within,
window.settings-window.style-dark .settings-spin:focus-within {
  border-color: {{dark.entry-focus-border}};
  box-shadow: {{dark.entry-focus-ring}};
}

button.settings-dropdown-trigger {
  background-image: none;
  box-shadow: none;
  text-shadow: none;
}

window.settings-window.style-light button.settings-dropdown-trigger:hover {
  background: {{light.trigger-hover-bg}};
}

window.settings-window.style-dark button.settings-dropdown-trigger:hover {
  background: {{dark.trigger-hover-bg}};
}

window.settings-window.style-light button.settings-dropdown-trigger:focus-visible {
  outline: none;
  border-color: {{light.entry-focus-border}};
  box-shadow: {{light.entry-focus-ring}};
}

window.settings-window.style-dark button.settings-dropdown-trigger:focus-visible {
  outline: none;
  border-color: {{dark.entry-focus-border}};
  box-shadow: {{dark.entry-focus-ring}};
}

/* The label and chevron inherit from the button, so they follow the theme
   rather than the window's default text colour. */
window.settings-window.style-light button.settings-dropdown-trigger label {
  color: {{light.control-text}};
}

window.settings-window.style-dark button.settings-dropdown-trigger label {
  color: {{dark.control-text}};
}

window.settings-window.style-light .settings-dropdown-chevron {
  color: {{light.chevron}};
}

window.settings-window.style-dark .settings-dropdown-chevron {
  color: {{dark.chevron}};
}

.settings-text-scroll {
  min-height: 120px;
  border-radius: {{radius-control}};
}

window.settings-window.style-light scrolledwindow.settings-text-scroll,
window.settings-window.style-light scrolledwindow.settings-text-scroll viewport {
  background-color: {{light.textview-bg}};
  border: 1px solid {{light.textview-border}};
  border-radius: {{radius-control}};
}

window.settings-window.style-dark scrolledwindow.settings-text-scroll,
window.settings-window.style-dark scrolledwindow.settings-text-scroll viewport {
  background-color: {{dark.textview-bg}};
  border: 1px solid {{dark.textview-border}};
  border-radius: {{radius-control}};
}

.settings-textview {
  padding: 10px 12px;
  font-size: 13px;
  font-family: {{font-mono}};
  background-color: transparent;
}

window.settings-window.style-light textview.settings-textview,
window.settings-window.style-light textview.settings-textview text {
  background-color: {{light.textview-bg}};
  color: {{light.textview-text}};
}

window.settings-window.style-dark textview.settings-textview,
window.settings-window.style-dark textview.settings-textview text {
  background-color: {{dark.textview-bg}};
  color: {{dark.textview-text}};
}

window.settings-window.style-dark textview.settings-textview:focus text,
window.settings-window.style-dark textview.settings-textview:focus-within text {
  background-color: {{dark.textview-bg}};
  color: {{dark.textview-text}};
}

window.settings-window.style-dark textview.settings-textview selection,
window.settings-window.style-dark textview.settings-textview text selection {
  background-color: {{dark.selection-bg}};
  color: {{dark.selection-text}};
}

window.settings-window.style-light textview.settings-textview selection,
window.settings-window.style-light textview.settings-textview text selection {
  background-color: {{light.selection-bg}};
  color: {{light.selection-text}};
}

.settings-check {
  font-size: 14px;
  letter-spacing: -0.01em;
  padding: 6px 0;
}

window.settings-window.style-light .settings-check {
  color: {{light.check-label}};
}

window.settings-window.style-dark .settings-check {
  color: {{dark.check-label}};
}

/* GTK4 native widgets — force dark surfaces (Adwaita defaults stay light) */
window.settings-window.style-dark entry.settings-entry {
  background-color: {{dark.entry-bg}};
  color: {{dark.entry-text}};
  border: 1px solid {{dark.entry-border}};
  border-radius: {{radius-control}};
  padding: 8px 12px;
}

window.settings-window.style-light entry.settings-entry {
  background-color: {{light.entry-bg}};
  color: {{light.entry-text}};
  border: 1px solid {{light.entry-border}};
  border-radius: {{radius-control}};
  padding: 8px 12px;
}

/* The peek icon inside a password entry, which Adwaita colours on its own. */
window.settings-window.style-dark entry.settings-entry image {
  color: {{dark.entry-icon}};
}

window.settings-window.style-light entry.settings-entry image {
  color: {{light.entry-icon}};
}

window.settings-window.style-dark dropdown.settings-dropdown > button,
window.settings-window.style-dark dropdown.settings-dropdown button,
window.settings-window.style-dark menubutton.settings-dropdown > button,
window.settings-window.style-dark menubutton.settings-dropdown button,
window.settings-window.style-dark dropdown > button {
  background-color: {{dark.entry-bg}};
  color: {{dark.entry-text}};
  border: 1px solid {{dark.entry-border}};
  border-radius: {{radius-control}};
  min-height: 36px;
  padding: 0 12px;
  box-shadow: none;
}

window.settings-window.style-dark dropdown.settings-dropdown button label,
window.settings-window.style-dark menubutton.settings-dropdown button label,
window.settings-window.style-dark dropdown button label {
  color: {{dark.entry-text}};
}

window.settings-window.style-light dropdown.settings-dropdown > button,
window.settings-window.style-light dropdown.settings-dropdown button,
window.settings-window.style-light menubutton.settings-dropdown > button,
window.settings-window.style-light menubutton.settings-dropdown button,
window.settings-window.style-light dropdown > button {
  background-color: {{light.entry-bg}};
  color: {{light.entry-text}};
  border: 1px solid {{light.entry-border}};
  border-radius: {{radius-control}};
  min-height: 36px;
  padding: 0 12px;
  box-shadow: none;
}

window.settings-window.style-light dropdown.settings-dropdown button label,
window.settings-window.style-light menubutton.settings-dropdown button label,
window.settings-window.style-light dropdown button label {
  color: {{light.entry-text}};
}

window.settings-window.style-dark dropdown.settings-dropdown > button {
  background-color: {{dark.entry-bg}};
  color: {{dark.entry-text}};
  border: 1px solid {{dark.entry-border}};
  border-radius: {{radius-control}};
  min-height: 36px;
  padding: 0 12px;
}

window.settings-window.style-light dropdown.settings-dropdown > button {
  background-color: {{light.entry-bg}};
  color: {{light.entry-text}};
  border: 1px solid {{light.entry-border}};
  border-radius: {{radius-control}};
  min-height: 36px;
  padding: 0 12px;
}

window.settings-window.style-dark spinbutton.settings-spin {
  background-color: {{dark.entry-bg}};
  color: {{dark.entry-text}};
  border: 1px solid {{dark.entry-border}};
  border-radius: {{radius-control}};
}

window.settings-window.style-dark spinbutton.settings-spin button {
  background-color: {{dark.spin-btn-bg}};
  color: {{dark.spin-btn-text}};
  border: none;
}

window.settings-window.style-light spinbutton.settings-spin button {
  background-color: {{light.spin-btn-bg}};
  color: {{light.spin-btn-text}};
}

window.settings-window.style-light spinbutton.settings-spin {
  background-color: {{light.entry-bg}};
  color: {{light.entry-text}};
  border: 1px solid {{light.entry-border}};
  border-radius: {{radius-control}};
}

window.settings-window.style-dark checkbutton.settings-check check {
  background-color: {{dark.check-bg}};
  border: 1px solid {{dark.check-border}};
  border-radius: 4px;
  min-width: 18px;
  min-height: 18px;
}

window.settings-window.style-dark checkbutton.settings-check:checked check {
  background-color: {{dark.check-checked-bg}};
  color: {{dark.check-checked-text}};
}

window.settings-window.style-light checkbutton.settings-check:checked check {
  background-color: {{light.check-checked-bg}};
  color: {{light.check-checked-text}};
}

window.settings-window.style-light checkbutton.settings-check check {
  background-color: {{light.check-bg}};
  border: 1px solid {{light.check-border}};
  border-radius: 4px;
  min-width: 18px;
  min-height: 18px;
}

window.settings-window.style-dark popover {
  background-color: {{dark.popover-bg}};
  color: {{dark.popover-text}};
  border: 1px solid {{dark.popover-border}};
}

/* The dropdown menu.
   A popover is its own surface, so `window.settings-window.style-dark` does not
   reach it; the window stamps style-dark / style-light onto each popover and
   these rules key off that. The selectors below follow the real widget tree —
   a box of buttons — which an earlier listbox/row markup left behind. */

/* The menu drops from its control and matches its width, so the options —
   which carry their own padding — line up with the text above them. */
popover.settings-dropdown-menu > contents {
  padding: 4px 0;
}

popover.settings-dropdown-menu.style-dark {
  background-color: {{dark.popover-bg}};
  color: {{dark.popover-text}};
  border: 1px solid {{dark.popover-border}};
}

/* The popover's pointer is a separate subnode and keeps the theme default
   unless it is styled too — a white triangle over a dark menu. */
popover.settings-dropdown-menu.style-dark > arrow {
  background-color: {{dark.popover-bg}};
  border: 1px solid {{dark.popover-border}};
}

popover.settings-dropdown-menu.style-dark > contents,
popover.settings-dropdown-menu.style-dark scrolledwindow,
popover.settings-dropdown-menu.style-dark viewport,
popover.settings-dropdown-menu.style-dark .settings-dropdown-menu-box {
  background-color: {{dark.popover-bg}};
  color: {{dark.popover-text}};
}

popover.settings-dropdown-menu.style-dark button.settings-dropdown-option {
  background-color: {{dark.popover-bg}};
  background-image: none;
  color: {{dark.popover-text}};
  border: none;
  border-radius: 0;
  box-shadow: none;
  min-height: 34px;
  padding: 0 12px;
}

popover.settings-dropdown-menu.style-dark button.settings-dropdown-option label {
  color: {{dark.popover-text}};
}

popover.settings-dropdown-menu.style-dark button.settings-dropdown-option:hover {
  background-color: {{dark.menu-hover-bg}};
}

popover.settings-dropdown-menu.style-dark button.settings-dropdown-option.selected-default {
  background-color: {{dark.menu-selected-bg}};
}

popover.settings-dropdown-menu.style-light {
  background-color: {{light.popover-bg}};
  color: {{light.popover-text}};
  border: 1px solid {{light.popover-border}};
}

popover.settings-dropdown-menu.style-light > arrow {
  background-color: {{light.popover-bg}};
  border: 1px solid {{light.popover-border}};
}

popover.settings-dropdown-menu.style-light > contents,
popover.settings-dropdown-menu.style-light scrolledwindow,
popover.settings-dropdown-menu.style-light viewport,
popover.settings-dropdown-menu.style-light .settings-dropdown-menu-box {
  background-color: {{light.popover-bg}};
  color: {{light.popover-text}};
}

popover.settings-dropdown-menu.style-light button.settings-dropdown-option {
  background-color: {{light.popover-bg}};
  background-image: none;
  color: {{light.popover-text}};
  border: none;
  border-radius: 0;
  box-shadow: none;
  min-height: 34px;
  padding: 0 12px;
}

popover.settings-dropdown-menu.style-light button.settings-dropdown-option label {
  color: {{light.popover-text}};
}

popover.settings-dropdown-menu.style-light button.settings-dropdown-option:hover {
  background-color: {{light.menu-hover-bg}};
}

popover.settings-dropdown-menu.style-light button.settings-dropdown-option.selected-default {
  background-color: {{light.menu-selected-bg}};
}


window.settings-window.style-dark popover listview row {
  background-color: transparent;
  color: {{dark.popover-text}};
}

window.settings-window.style-dark popover listview row:selected {
  background-color: {{dark.menu-selected-bg}};
}

/* Segmented theme control (replaces dropdown on Appearance page) */
.settings-segmented {
  border-radius: {{radius-control}};
  padding: 3px;
}

window.settings-window.style-light .settings-segmented {
  background: {{light.segmented-bg}};
  border: 1px solid {{light.segmented-border}};
}

window.settings-window.style-dark .settings-segmented {
  background: {{dark.segmented-bg}};
  border: 1px solid {{dark.segmented-border}};
}

.settings-segment {
  min-height: 32px;
  padding: 0 14px;
  border-radius: {{radius-segment}};
  font-size: 13px;
  font-weight: 500;
  border: none;
  box-shadow: none;
  transition: background 140ms ease, color 140ms ease, transform 100ms ease;
}

.settings-segment:active {
  transform: scale(0.97);
}

window.settings-window.style-light .settings-segment {
  color: {{light.segment-text}};
  background: transparent;
}

window.settings-window.style-light .settings-segment:checked {
  color: {{light.segment-checked-text}};
  background: {{light.segment-checked-bg}};
  box-shadow: {{light.segment-checked-shadow}};
}

window.settings-window.style-dark .settings-segment {
  color: {{dark.segment-text}};
  background: transparent;
}

window.settings-window.style-dark .settings-segment:checked {
  color: {{dark.segment-checked-text}};
  background: {{dark.segment-checked-bg}};
  box-shadow: {{dark.segment-checked-shadow}};
}

.settings-badge {
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  border-radius: {{radius-pill}};
  padding: 3px 8px;
}

window.settings-window.style-light .settings-badge-muted {
  color: {{light.badge-muted-text}};
  background: {{light.badge-muted-bg}};
}

window.settings-window.style-dark .settings-badge-muted {
  color: {{dark.badge-muted-text}};
  background: {{dark.badge-muted-bg}};
}

window.settings-window.style-light .settings-badge-ok {
  color: {{light.badge-ok-text}};
  background: {{light.badge-ok-bg}};
}

window.settings-window.style-dark .settings-badge-ok {
  color: {{dark.badge-ok-text}};
  background: {{dark.badge-ok-bg}};
}

window.settings-window.style-light .settings-badge-active {
  color: {{light.badge-active-text}};
  background: {{light.badge-active-bg}};
}

window.settings-window.style-dark .settings-badge-active {
  color: {{dark.badge-active-text}};
  background: {{dark.badge-active-bg}};
}

window.settings-window.style-light .settings-badge-busy {
  color: {{light.badge-busy-text}};
  background: {{light.badge-busy-bg}};
}

window.settings-window.style-dark .settings-badge-busy {
  color: {{dark.badge-busy-text}};
  background: {{dark.badge-busy-bg}};
}

window.settings-window.style-light .settings-badge-warn {
  color: {{light.badge-warn-text}};
  background: {{light.badge-warn-bg}};
}

window.settings-window.style-dark .settings-badge-warn {
  color: {{dark.badge-warn-text}};
  background: {{dark.badge-warn-bg}};
}

.settings-model-list,
.settings-item-list {
  border-radius: {{radius-list}};
}

window.settings-window.style-light .settings-model-list,
window.settings-window.style-light .settings-item-list {
  background: {{light.list-bg}};
  border: 1px solid {{light.list-border}};
}

window.settings-window.style-dark .settings-model-list,
window.settings-window.style-dark .settings-item-list {
  background: {{dark.list-bg}};
  border: 1px solid {{dark.list-border}};
}

listbox.settings-model-list row,
listbox.settings-item-list row {
  background-color: transparent;
  padding: 0;
}

.settings-model-row-inner,
.settings-item-row {
  padding: 12px 14px;
}

window.settings-window.style-light .settings-model-row-inner,
window.settings-window.style-light .settings-item-row {
  border-bottom: 1px solid {{light.divider}};
}
window.settings-window.style-dark .settings-model-row-inner,
window.settings-window.style-dark .settings-item-row {
  border-bottom: 1px solid {{dark.divider}};
}


listbox.settings-model-list row:last-child .settings-model-row-inner,
listbox.settings-item-list row:last-child {
  border-bottom: none;
}

.settings-model-name,
.settings-item-title {
  font-size: 14px;
  font-weight: 600;
  letter-spacing: -0.01em;
}

window.settings-window.style-light .settings-model-name,
window.settings-window.style-light .settings-item-title {
  color: {{light.item-title}};
}

window.settings-window.style-dark .settings-model-name,
window.settings-window.style-dark .settings-item-title {
  color: {{dark.item-title}};
}

.settings-mcp-form {
  margin-top: 16px;
  padding-top: 16px;
}

window.settings-window.style-light .settings-mcp-form {
  border-top: 1px solid {{light.divider}};
}
window.settings-window.style-dark .settings-mcp-form {
  border-top: 1px solid {{dark.divider}};
}


window.settings-window.style-dark .settings-mcp-form {
  border-top-color: {{dark.divider}};
}

.settings-toggles {
  margin-top: 4px;
}

.settings-actions {
  margin-top: 12px;
}

.settings-btn-primary,
.settings-btn-secondary {
  min-height: 34px;
  padding: 0 14px;
  border-radius: {{radius-btn}};
  font-size: 13px;
  font-weight: 500;
  letter-spacing: -0.01em;
  border: none;
  transition: transform 120ms cubic-bezier(0.23, 1, 0.32, 1), background 160ms ease;
}

.settings-btn-primary:active,
.settings-btn-secondary:active {
  transform: scale(0.97);
}

window.settings-window.style-light .settings-btn-primary {
  color: {{light.btn-primary-text}};
  background: {{light.btn-primary-bg}};
}

window.settings-window.style-light .settings-btn-primary:hover {
  background: {{light.btn-primary-hover-bg}};
}

window.settings-window.style-dark .settings-btn-primary {
  color: {{dark.btn-primary-text}};
  background: {{dark.btn-primary-bg}};
}

window.settings-window.style-dark .settings-btn-primary:hover {
  background: {{dark.btn-primary-hover-bg}};
}

window.settings-window.style-light .settings-btn-secondary {
  color: {{light.btn-secondary-text}};
  background: {{light.btn-secondary-bg}};
}

window.settings-window.style-light .settings-btn-secondary:hover {
  background: {{light.btn-secondary-hover-bg}};
}

window.settings-window.style-dark .settings-btn-secondary {
  color: {{dark.btn-secondary-text}};
  background: {{dark.btn-secondary-bg}};
}

window.settings-window.style-dark .settings-btn-secondary:hover {
  background: {{dark.btn-secondary-hover-bg}};
}

.settings-mcp-list {
  font-size: 13px;
  line-height: 1.55;
  font-family: {{font-mono}};
  padding: 12px;
  border-radius: {{radius-control}};
}

window.settings-window.style-light .settings-mcp-list {
  color: {{light.mcp-list-text}};
  background: {{light.mcp-list-bg}};
  border: 1px solid {{light.mcp-list-border}};
}

window.settings-window.style-dark .settings-mcp-list {
  color: {{dark.mcp-list-text}};
  background: {{dark.mcp-list-bg}};
  border: 1px solid {{dark.mcp-list-border}};
}

.settings-footer {
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  padding: 10px 24px 14px;
  min-height: 18px;
}

window.settings-window.style-light .settings-footer {
  border-top: 1px solid {{light.divider}};
}
window.settings-window.style-dark .settings-footer {
  border-top: 1px solid {{dark.divider}};
}


window.settings-window.style-light .settings-footer {
  color: {{light.footer-text}};
  border-top-color: {{light.divider}};
}

window.settings-window.style-dark .settings-footer {
  color: {{dark.footer-text}};
  border-top-color: {{dark.divider}};
}

@media (prefers-reduced-motion: reduce) {
  .settings-nav-row,
  .settings-btn-primary,
  .settings-btn-secondary {
    transition: none;
  }

  .settings-stack {
    transition-duration: 0ms;
  }
}

  background-color: {{light.window-bg}};
}

.settings-page {
  padding: 20px 24px 16px;
}

.settings-stack {
  min-height: 0;
}

.settings-section {
  margin-bottom: 8px;
}

.settings-section-title {
  font-size: 15px;
  font-weight: 600;
  letter-spacing: -0.02em;
  margin-bottom: 2px;
}

window.settings-window.style-light .settings-section-title {
  color: {{light.section-title}};
}

window.settings-window.style-dark .settings-section-title {
  color: {{dark.section-title}};
}

.settings-section-desc {
  font-size: 13px;
